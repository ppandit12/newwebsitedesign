# ─────────────────────────────────────────────────────────────
# NumberX website — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ---- Frontend (baked into the build; must start with VITE_) ----
# Public site URL, used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://mynumberx.com
# Base URL of the API. Leave empty when the API is served from the same origin (/api).
VITE_API_URL=
# Optional approved scheduling link (e.g. a Calendly page). Leave empty to hide online booking.
VITE_BOOKING_URL=

# ---- API server ----
PORT=8787
NODE_ENV=development
# Serve the prerendered site from ./dist in the same process (single-server deploys).
SERVE_STATIC=false
# Comma-separated origins allowed to call the API when the site is hosted elsewhere.
ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the server (e.g. 1 behind Render/Railway/Nginx).
TRUST_PROXY=0
# Minimum milliseconds between form render and submit (spam protection).
MIN_FILL_MS=3000
# Origins allowed in an iframe, only if a booking widget is embedded later.
BOOKING_FRAME_ORIGINS=

# ---- Email (SMTP) — required for the consultation form ----
# Local testing: run `npm run mail:dev` and use SMTP_HOST=127.0.0.1, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be authorised by the SMTP provider), e.g. "NumberX Website <no-reply@mynumberx.com>"
MAIL_FROM=
# Where new consultation requests are delivered.
CONTACT_TO=info@mynumberx.com
# Send an automatic confirmation email to the visitor (requires client approval).
SEND_CONFIRMATION_EMAIL=false
